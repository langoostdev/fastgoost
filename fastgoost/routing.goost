// routing.goost — path patterns: compiling them, scoring them, matching them.
//
// A pattern is a path with optional placeholders:
//
//   /users                     literal
//   /users/{id}                one segment, captured as a string
//   /users/{id:int}            one segment, captured and converted
//   /files/{rest:path}         the remainder of the path, slashes included
//   /assets/*                  the remainder, captured as "*"
//
// Converters: int, float, bool, str (the default), path.
//
// Internal to fastgoost.

import strings

let KIND_WILD   = 1
let KIND_PARAM  = 2
let KIND_STATIC = 3

// Only the first SCORE_DEPTH segments contribute to a pattern's score. Beyond
// that the ranking is settled anyway, and going deeper would overflow.
let SCORE_DEPTH = 20

// ── Compiling ──────────────────────────────────────────────────────────────

// compile turns a pattern string into the matcher's internal form:
//
//   {pattern, segments, params, greedy, static, score}
//
// `static` is true when the pattern has no placeholders at all, which lets the
// router look it up directly instead of scanning.
//
// Throws on a malformed pattern — an unclosed brace or an unknown converter —
// because that is a bug in the route table, found at startup rather than on
// the first request that happens to hit it.
fn compile(pattern: string): object {
    let path = pattern
    if path == "" { path = "/" }
    if !strings.hasPrefix(path, "/") { path = "/" + path }

    let segments = []
    let params = []
    let greedy = false
    let isStatic = true

    let raw = strings.split(path, "/")
    let i = 1
    while i < len(raw) {
        let seg = raw[i]
        // "/" splits to ["", ""] and "/a/" to ["", "a", ""]; an empty piece is
        // the slash itself, not a segment to match.
        if seg == "" {
            i += 1
            continue
        }
        if greedy {
            throw {
                kind:    "RouteError",
                message: "route \"" + pattern + "\": nothing may follow a greedy segment",
            }
        }

        if seg == "*" {
            segments = append(segments, {kind: KIND_WILD, name: "*", conv: "path", text: ""})
            params = append(params, "*")
            greedy = true
            isStatic = false
        } else if strings.hasPrefix(seg, "{") && strings.hasSuffix(seg, "}") {
            let inner = strings.slice(seg, 1, len(seg) - 1)
            let name = inner
            let conv = "str"
            let colon = strings.indexOf(inner, ":")
            if colon >= 0 {
                name = strings.slice(inner, 0, colon)
                conv = strings.slice(inner, colon + 1, len(inner))
            }
            if name == "" {
                throw {kind: "RouteError", message: "route \"" + pattern + "\": empty parameter name"}
            }
            if !isConverter(conv) {
                throw {
                    kind:    "RouteError",
                    message: "route \"" + pattern + "\": unknown converter \"" + conv + "\" (use int, float, bool, str or path)",
                }
            }
            if conv == "path" { greedy = true }
            segments = append(segments, {kind: KIND_PARAM, name: name, conv: conv, text: ""})
            params = append(params, name)
            isStatic = false
        } else if strings.indexOf(seg, "{") >= 0 || strings.indexOf(seg, "}") >= 0 {
            throw {
                kind:    "RouteError",
                message: "route \"" + pattern + "\": a placeholder must fill a whole segment, as in /users/{id}",
            }
        } else {
            segments = append(segments, {kind: KIND_STATIC, name: "", conv: "", text: seg})
        }
        i += 1
    }

    return {
        pattern:  path,
        segments: segments,
        params:   params,
        greedy:   greedy,
        static:   isStatic,
        score:    specificity(segments, greedy),
    }
}

fn isConverter(conv: string): bool {
    return conv == "str" || conv == "string" || conv == "int" || conv == "float" || conv == "bool" || conv == "path"
}

// specificity ranks patterns so that the most specific one wins when several
// match. Segments are read left to right as base-4 digits, so a literal
// beats a placeholder at the leftmost position where they differ:
// /files/latest outranks /files/{name}, whatever order they were registered.
fn specificity(segments, greedy: bool): int {
    let score = 0
    let depth = len(segments)
    if depth > SCORE_DEPTH { depth = SCORE_DEPTH }
    let i = 0
    while i < SCORE_DEPTH {
        score = score * 4
        if i < depth { score = score + segments[i].kind }
        i += 1
    }
    // A greedy pattern is the fallback of last resort among equals.
    if greedy { score = score - 1 }
    return score
}

// ── Matching ───────────────────────────────────────────────────────────────

// match tests a compiled route against a request path. Returns the captured
// parameters as an object, or void when the route does not apply.
//
// Converters run here, so a route declared {id:int} either matches with an
// int in hand or does not match at all — a handler never sees "abc" where it
// asked for a number.
fn match(route, path: string) {
    let parts = splitPath(path)
    let segs = route.segments
    let params = {}

    if !route.greedy && len(parts) != len(segs) { return }
    if route.greedy && len(parts) < len(segs) - 1 { return }

    let i = 0
    while i < len(segs) {
        let seg = segs[i]

        if seg.kind == KIND_STATIC {
            if i >= len(parts) || parts[i] != seg.text { return }
            i += 1
            continue
        }

        if seg.kind == KIND_WILD || seg.conv == "path" {
            // Greedy: swallow every remaining segment, re-joined verbatim.
            let rest = []
            let j = i
            while j < len(parts) {
                rest = append(rest, parts[j])
                j += 1
            }
            params[seg.name] = strings.join(rest, "/")
            return params
        }

        if i >= len(parts) { return }
        let converted = convert(parts[i], seg.conv)
        if typeof(converted) == "void" { return }
        params[seg.name] = converted
        i += 1
    }

    return params
}

// splitPath breaks a path into its non-empty segments, percent-decoding each
// one. Decoding here rather than earlier is deliberate: a %2F inside a
// segment stays inside that segment and cannot forge a path boundary.
fn splitPath(path: string): string[] {
    let out = []
    for seg in strings.split(path, "/") {
        if seg == "" { continue }
        out = append(out, decodeSegment(seg))
    }
    return out
}

// decodeSegment percent-decodes at the byte level and reassembles at the end,
// so a multi-byte UTF-8 escape such as %D0%B0 rebuilds one character rather
// than two mangled ones.
fn decodeSegment(seg: string): string {
    if strings.indexOf(seg, "%") < 0 { return seg }
    let bytes = []
    let i = 0
    while i < len(seg) {
        if strings.byteAt(seg, i) == 37 && i + 2 < len(seg) {
            let code = hexByte(strings.slice(seg, i + 1, i + 3))
            if code >= 0 {
                bytes = append(bytes, code)
                i += 3
                continue
            }
        }
        bytes = append(bytes, strings.byteAt(seg, i))
        i += 1
    }
    return strings.fromBytes(bytes)
}

fn hexByte(hex: string): int {
    let hi = hexDigit(strings.byteAt(hex, 0))
    let lo = hexDigit(strings.byteAt(hex, 1))
    if hi < 0 || lo < 0 { return -1 }
    return hi * 16 + lo
}

fn hexDigit(b: int): int {
    if b >= 48 && b <= 57  { return b - 48 }
    if b >= 97 && b <= 102 { return b - 87 }
    if b >= 65 && b <= 70  { return b - 55 }
    return -1
}

// convert applies a path converter, returning void when the raw segment is
// not a member of the converter's type.
fn convert(raw: string, conv: string) {
    if conv == "str" || conv == "string" || conv == "path" { return raw }

    if conv == "int" {
        if !looksNumeric(raw, false) { return }
        try { return toInt(raw) } catch e { return }
    }
    if conv == "float" {
        if !looksNumeric(raw, true) { return }
        try { return toFloat(raw) } catch e { return }
    }
    if conv == "bool" {
        let lower = strings.lower(raw)
        if lower == "true" || lower == "1" || lower == "yes"  { return true }
        if lower == "false" || lower == "0" || lower == "no" { return false }
        return
    }
    return raw
}

// looksNumeric is the pre-check that keeps toInt/toFloat from being asked a
// question they answer by throwing.
fn looksNumeric(raw: string, allowDot: bool): bool {
    if raw == "" { return false }
    let start = 0
    if strings.hasPrefix(raw, "-") || strings.hasPrefix(raw, "+") { start = 1 }
    if start >= len(raw) { return false }
    let digits = 0
    let dots = 0
    let i = start
    while i < len(raw) {
        let b = strings.byteAt(raw, i)
        if b >= 48 && b <= 57 {
            digits += 1
        } else if allowDot && b == 46 {
            dots += 1
            if dots > 1 { return false }
        } else {
            return false
        }
        i += 1
    }
    return digits > 0
}
